{
  "name": "dsh-media-serve",
  "version": "0.2.3",
  "description": "DeepSeek Harness host plugin: serves a configured workspace/media folder over the web server under /media, so any conversation can display local images by referencing http://<host>:<port>/media/<relative-path>.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qfwycn/dsh-media-serve.git"
  },
  "homepage": "https://github.com/qfwycn/dsh-media-serve#readme",
  "bugs": {
    "url": "https://github.com/qfwycn/dsh-media-serve/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "media",
    "image"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
